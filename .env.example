# Launch gate: comma-separated emails allowed into the app before public launch.
# Empty/unset = gate OFF (everyone allowed). Super admins always bypass.
ALLOWLIST_EMAILS=

# Bull Board admin dashboard (Phase 1 basic-auth)
QUEUE_ADMIN_USER=admin
QUEUE_ADMIN_PASSWORD=change-me-in-prod

# TikTok app audit gate — set to "true" only after TikTok approves the Direct Post API audit
TIKTOK_APP_AUDITED=false

# YouTube quota safety
# Set to 'true' only after the YouTube API Services Compliance Audit passes.
# Unset or any other value = unaudited, which enforces conservative caps.
YOUTUBE_APP_AUDITED=false
# Share of YouTube's 10,000/day unit pool that inbox comment polling may spend.
YOUTUBE_INBOX_DAILY_UNITS=3000

# TikTok domain-ownership verification file body (served at /tiktok<token>.txt).
# Optional — defaults to the committed token. Set only to rotate without a code change.
# TIKTOK_SITE_VERIFICATION=tiktok-developers-site-verification=BWGOXBTMJ4RXb76i56qZc99OfEZIAzIi

# Public base URL of the backend (used for TikTok PULL_FROM_URL proxy)
API_PUBLIC_URL=https://api.schedura.ai

# Discord (inbox) — one shared bot for the whole platform
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Set to "true" on EXACTLY ONE running instance so the Gateway connects once.
# Discord disconnects a bot that opens a second IDENTIFY — never enable on >1 replica.
DISCORD_GATEWAY_ENABLED=false

# --- WhatsApp Cloud API (inbox) ---
# Shared Meta webhook verify token (GET challenge); also used by FB/IG/Threads.
META_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret — verifies POST webhook signatures (X-Hub-Signature-256).
# REQUIRED for WhatsApp webhooks; without it every POST is rejected (fail-closed).
META_APP_SECRET=
# Meta app id (public) — needed for WhatsApp Embedded Signup code exchange
META_APP_ID=
# Facebook Login for Business configuration id for WhatsApp Embedded Signup
WHATSAPP_ES_CONFIG_ID=

# Threads (Meta) OAuth app credentials — from the Threads use-case in your Meta app.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# --- Inline AI assist (composer caption/hashtags/per-channel) ---
# Gemini is the primary provider for inline generation (best multilingual +
# reliability). If GOOGLE_AI_API_KEY is unset, the app silently falls back to
# GROQ_API_KEY — no breakage, lower copy quality. (Maestro/agentic AI uses
# Anthropic separately and is unaffected by these keys.)
# Gemini: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
# Groq (fallback for inline; also used by evergreen/other /ai endpoints): https://console.groq.com/keys
GROQ_API_KEY=

# --- Composer stock-media providers (free API keys) ---
# Each source in the composer's Add-media dialog needs its own key. Without a
# key, that source shows a clean "try later" empty state; others keep working.
# Pixabay (images + videos): https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# GIPHY (GIFs): https://developers.giphy.com/ (create an app)
GIPHY_API_KEY=
# Coverr (free stock videos): https://coverr.co/developers
COVERR_API_KEY=
# Flickr (Creative-Commons photos): https://www.flickr.com/services/apps/create/apply/
FLICKR_API_KEY=

# --- Maestro (the in-app AI agent, Claude Agent SDK) ---
# Maestro is a paid, multi-tenant product, so every run must bill to an Anthropic
# API account. In production ANTHROPIC_API_KEY is REQUIRED — without it Maestro
# refuses to start a turn and users see a "not configured" message.
# Anthropic console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Auth mode. Default (unset) = apikey, which is what production must use.
# Set to `subscription` ONLY for local development, to bill an interactive
# Claude Code (Max plan) OAuth session instead of the API key. It is REFUSED
# when NODE_ENV=production — a container has no interactive session, and one
# personal subscription is not a commercial multi-tenant billing path.
# MAESTRO_AUTH_MODE=subscription
# Overrides the default agent model (claude-haiku-4-5).
# MAESTRO_MODEL=claude-haiku-4-5

# --- Which provider bills new accounts -----------------------------------
# 'stripe' | 'lemonsqueezy'. Any other value makes the app throw on the first
# billing call rather than guessing.
#
# This decides ONE thing: which provider a brand-NEW account is signed up with.
# An existing account is never affected - its own provider_subscriptions row
# carries is_default=true, and that row always wins. So flipping this when
# Stripe goes live moves new signups only, while existing Lemon Squeezy
# customers finish their period where they are. That is the whole cutover.
#
# SAFE DEFAULT: leave it UNSET, which resolves to 'lemonsqueezy'. Deliberately
# NOT 'stripe': defaulting to Stripe would mean any account whose provider row
# failed to write billed silently through Stripe, which is the exact failure
# this abstraction exists to prevent.
# BILLING_PROVIDER=lemonsqueezy

# --- Lemon Squeezy (payment provider) ------------------------------------
# Lemon Squeezy is a Merchant of Record: it is the seller of record, handles
# VAT/sales tax itself, and pays out to countries Stripe does not serve
# directly. It goes live FIRST; Stripe returns once the LLC and a live Stripe
# account exist. Both providers therefore coexist — do NOT delete the Stripe
# variables above.
#
# API key. Store-scoped, created at Settings > API in the Lemon Squeezy
# dashboard. TEST-MODE AND LIVE KEYS ARE DIFFERENT KEYS — a test key only ever
# sees test data, which is what makes local development safe.
# NOTE: Lemon Squeezy API keys EXPIRE ONE YEAR after creation. That failure is
# silent and total (every billing call 401s), so put the expiry in a calendar.
LEMONSQUEEZY_API_KEY=
# Store id (an integer, visible in the dashboard URL and in Settings > Stores).
# Every checkout must name the store it belongs to.
LEMONSQUEEZY_STORE_ID=
# Webhook signing secret. You choose this string when creating the webhook in
# the dashboard; 6-40 characters. Requests are signed HMAC-SHA256 over the RAW
# body and delivered in the X-Signature header, so the webhook route needs the
# raw body (same requirement as the Stripe route).
# It is NEVER returned by the API — if lost, it can only be reset in the
# dashboard.
LEMONSQUEEZY_WEBHOOK_SECRET=
#
# Variant ids map our plan/add-on codes onto Lemon Squeezy products. A variant
# id is NOT the product id: open the product, expand its variant, and take the
# id from the variant's URL or the API.
#
# These matter more here than they do on Stripe. A Lemon Squeezy subscription
# holds exactly ONE variant — there is no POST /v1/subscription-items — so an
# add-on cannot be a line item on the plan subscription the way it is on
# Stripe. Each add-on is its own subscription, and the variant id is the ONLY
# thing that tells an incoming webhook whether it concerns the base plan or an
# add-on.
#
# These four are what `src/drizzle/seeds/provider-prices.seed.ts` writes into
# provider_prices; an unset or blank one is SKIPPED, never written as a blank
# reference. A missing row is the good failure: CatalogueService throws a 400
# naming the provider, plan and item type, before any money moves.
#
# STILL MISSING (run the seed - it prints the full list): EXTRA_MEMBER,
# EXTRA_WORKSPACE and EXTRA_AI_TOKENS have no Lemon Squeezy product at all, and
# EXTRA_CHANNEL exists for PRO only. addon_pricing prices each add-on PER PLAN,
# and the adapter resolves with the account's own plan code, so BASIC and MAX
# customers cannot buy an extra channel until those products exist too.
LEMONSQUEEZY_VARIANT_BASIC=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_MAX=
LEMONSQUEEZY_VARIANT_EXTRA_CHANNEL=
